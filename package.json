{
  "name": "speedway-internacional",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && concurrently -k -n web,api \"vite build --watch\" \"wrangler dev\"",
    "build": "vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "bun run scripts/seed.ts"
  },
  "dependencies": {
    "hono": "^4.11.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.86.0"
  }
}
